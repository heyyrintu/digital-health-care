# Copy into Coolify environment variables; never commit filled values.
APP_URL=https://preview.example.com
RELEASE_TAG=client-preview-1
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
# Actual network from: docker network inspect coolify
# The gateway trusts forwarded client addresses only from this proxy subnet.
COOLIFY_PROXY_CIDR=
# Optional platform-console access. Leave empty to deny all; never use * or 0.0.0.0/0.
PLATFORM_ALLOWED_CIDRS=
PRIVACY_NOTICE_URL=
TERMS_URL=

# Staff/platform second-factor choices: totp (default), whatsapp, disabled (password only).
STAFF_MFA_MODE=totp
PLATFORM_MFA_MODE=totp
STAFF_MFA_PHONES_JSON=
PLATFORM_MFA_PHONES_JSON=
# Patient and second-factor OTP delivery. WhatsApp mode requires all sender values below.
OTP_DELIVERY=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=

# Staff contact verification email: TLS SMTP, disabled until configured.
STAFF_EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
