# Copy into Coolify environment variables; never commit filled values.
APP_URL=https://preview.example.com
RELEASE_TAG=client-preview-1
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
# Actual network from: docker network inspect coolify
# The gateway trusts forwarded client addresses only from this proxy subnet.
COOLIFY_PROXY_CIDR=
# Optional platform-console access. Leave empty to deny all; never use * or 0.0.0.0/0.
PLATFORM_ALLOWED_CIDRS=
PRIVACY_NOTICE_URL=
TERMS_URL=
