# Copy to .env for local development. Never commit real secrets or patient data.
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Local services (docker compose). The API switches to the restricted dhc_app /
# dhc_auth roles inside every request (ADR 0014).
DATABASE_URL=postgresql://dhc:dhc@localhost:5432/dhc
REDIS_URL=redis://localhost:6379

# Auth. Generate local values with:  openssl rand -base64 32
JWT_SECRET=
# 32 bytes, base64. Encrypts TOTP secrets at rest.
FIELD_ENCRYPTION_KEY=
# `log` prints patient sign-in codes to the API console (development only).
OTP_DELIVERY=log

# Prescription signing (ADR 0008): `test_key` signs with a key derived from JWT_SECRET,
# marked not legally valid. Development and staging only; refused in production.
SIGNER=test_key
# Where signed PDFs are kept until object storage is connected.
FILE_STORE_DIR=.data/files

# Web app origin; staff invite links point here, and the API allows it via CORS.
WEB_BASE_URL=http://localhost:3000
# Optional: comma-separated extra browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:3000,https://staging.example.com

# Integration and browser tests (separate, disposable databases)
TEST_DATABASE_URL=postgresql://dhc:dhc@localhost:5432/dhc_test
E2E_DATABASE_URL=postgresql://dhc:dhc@localhost:5432/dhc_e2e

# Clients. The web app reads API_BASE_URL when pages render (one build for every
# environment); NEXT_PUBLIC_API_BASE_URL is the build-time fallback.
API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
# Optional: API address for the web app's own server routes, if it differs from the public one.
# API_INTERNAL_BASE_URL=http://api.internal:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1
