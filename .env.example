# Copy to .env for local development. Never commit real secrets or patient data.
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Local services (docker compose). The API switches to the restricted dhc_app /
# dhc_auth roles inside every request (ADR 0014).
DATABASE_URL=postgresql://dhc:dhc@localhost:5432/dhc
# Workers' queues (BullMQ). The API reads only job counts from it, for the platform
# console's system health; without it the API shows the queues as not configured.
REDIS_URL=redis://localhost:6379

# Auth. Generate local values with:  openssl rand -base64 32
JWT_SECRET=
# 32 bytes, base64. Encrypts TOTP secrets at rest.
FIELD_ENCRYPTION_KEY=
# `log` prints patient sign-in codes to the API console (development only).
OTP_DELIVERY=log
# Live patient OTPs: set OTP_DELIVERY=whatsapp and provide ALL five values below.
# Keep these commented until configured. See docs/runbooks/whatsapp-otp.md.
# WHATSAPP_ACCESS_TOKEN=<system-user-token>
# WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>
# WHATSAPP_GRAPH_API_VERSION=<supported-version-such-as-v23.0>
# WHATSAPP_OTP_TEMPLATE_NAME=patient_sign_in
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Optional delivery callbacks. Keep false until Meta's webhook is configured.
WHATSAPP_WEBHOOK_ENABLED=false
# Appointment sending stays off until opt-ins, callbacks and approved templates are ready.
WHATSAPP_APPOINTMENTS_ENABLED=false
# Generic record-ready notices; API and workers need the same separate random signing key.
WHATSAPP_RECORDS_ENABLED=false
# API + workers: optional payment/receipt/refund availability notices; separate opt-in.
WHATSAPP_PAYMENTS_ENABLED=false
# WHATSAPP_PAYMENT_LINK_SECRET=<separate-random-secret-at-least-32-characters>
# WHATSAPP_PAYMENT_TEMPLATE=payment_update
# WHATSAPP_PAYMENT_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_RECORD_LINK_SECRET=<random-secret-at-least-32-characters>
# Workers only: approved generic template with ONE body parameter (the portal link).
# WHATSAPP_RECORD_TEMPLATE=record_available
# WHATSAPP_RECORD_TEMPLATE_LANGUAGE=en_US
# Workers only; WEB_BASE_URL must be HTTPS when appointment sending is enabled.
# WHATSAPP_APPOINTMENT_CONFIRMATION_TEMPLATE=appointment_confirmed
# WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE=appointment_reminder
# WHATSAPP_APPOINTMENT_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_APP_SECRET=<meta-app-secret>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<random-token-at-least-32-characters>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<numeric-whatsapp-business-account-id>
# Workers need DATABASE_URL and REDIS_URL to process saved delivery receipts.

# Prescription signing (ADR 0008): `test_key` signs with a key derived from JWT_SECRET,
# marked not legally valid. Development and staging only; refused in production.
SIGNER=test_key
# Where signed PDFs are kept until object storage is connected.
FILE_STORE_DIR=.data/files
# Seconds between runs that mark bookings past the clinic's grace period as no-shows; 0 = off.
NO_SHOW_SWEEP_SECONDS=60

# Web app origin; staff invite links point here, and the API allows it via CORS.
WEB_BASE_URL=http://localhost:3000
# Optional: comma-separated extra browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:3000,https://staging.example.com

# Platform console (ADR 0016): networks that may reach /v1/platform/*, comma-separated CIDRs.
# `*` allows any address (local development only; refused in production). Empty allows
# nobody, except under NODE_ENV=test.
PLATFORM_ALLOWED_CIDRS=*
# Production only: how many proxies in front of the API add X-Forwarded-For entries
# (default 1), and their networks. Without TRUSTED_PROXY_CIDRS, set TRUST_PROXY_HOPS=0
# unless the API port can be reached only from the load balancer, or anyone reaching it
# directly can claim any address.
# TRUST_PROXY_HOPS=1
# TRUSTED_PROXY_CIDRS=10.0.0.0/16
# Uploaded PDFs rebuilt at once (1 to 4, default 1). Each needs up to about 400 MB of the
# API's memory on hostile files: raise it only with the container's memory (runbook deploy.md).
# PDF_REBUILD_CONCURRENCY=1
# Web app: pass the browser's address (the rightmost X-Forwarded-For entry, written by the
# load balancer) to the API from the session routes. Off by default. Turn on only once the
# web servers accept traffic from the load balancer alone and their subnets are in
# TRUSTED_PROXY_CIDRS (API guide §3s).
# FORWARD_CLIENT_IP=true

# Integration and browser tests (separate, disposable databases)
TEST_DATABASE_URL=postgresql://dhc:dhc@localhost:5432/dhc_test
E2E_DATABASE_URL=postgresql://dhc:dhc@localhost:5432/dhc_e2e

# Clients. The web app reads API_BASE_URL when pages render (one build for every
# environment); NEXT_PUBLIC_API_BASE_URL is the build-time fallback.
API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
# Public website's own address for canonical links, OpenGraph and schema markup on doctor
# pages (ADR 0017) and the sitemap; defaults to WEB_BASE_URL. Production must set one of them.
# PUBLIC_SITE_URL=https://www.example.com
# Seconds the public pages keep the API's answers (60-300, default 300). Leave unset. Values
# below 60 are raised to 60 (with a warning) unless DHC_E2E=1, a test-only flag: the browser
# tests set 1 so doctors listed by different tests show at once.
# PUBLIC_API_CACHE_SECONDS=300
# Optional: API address for the web app's own server routes, if it differs from the public one.
# API_INTERNAL_BASE_URL=http://api.internal:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1
# The Patient app links to these from onboarding; release builds must set both.
# EXPO_PUBLIC_PRIVACY_NOTICE_URL=https://example.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://example.com/terms
# The web patient portal (/app) links to the same documents from its consents screen,
# read when pages render; production must set both, or patients cannot accept the consents.
# PRIVACY_NOTICE_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms

# Online collection for existing bills (kept off until each clinic completes Cashfree setup).
CASHFREE_ENABLED=false
# Separate gate for new refund requests; checks/callbacks keep working when it is false.
CASHFREE_REFUNDS_ENABLED=false
# API only: prepaid in-person web booking; keep disabled until the sandbox pilot is complete.
CASHFREE_PREPAID_BOOKING_ENABLED=false
# API + workers: read-only settlement reporting; requires DATABASE_URL and the same clinic accounts.
CASHFREE_RECONCILIATION_ENABLED=false
# Nightly rolling completed IST days, 1–31; manual historical windows are available in the admin screen.
CASHFREE_RECONCILIATION_LOOKBACK_DAYS=7
# Set false to pause new links/checkout while still accepting callbacks and status checks.
CASHFREE_ACCEPT_NEW_PAYMENTS=true
# CASHFREE_LINK_SECRET=<separate-random-secret-at-least-32-characters>
# CASHFREE_WEBHOOK_URL=https://api.example.in/v1/webhooks/cashfree
# One distinct merchant account per organisation UUID; secrets stay server-side.
# CASHFREE_MERCHANTS_JSON={"<organisation-uuid>":{"clientId":"<app-id>","clientSecret":"<secret-key>","environment":"sandbox"}}
# WEB_BASE_URL must be public HTTPS and whitelisted with Cashfree before enabling.

# Conversational inbox: off until clinic-owned numbers and Meta permissions are configured.
# Each clinic and phone-number ID is unique; bindings become immutable after first use.
# Inbox numbers must differ from the shared OTP/automated-notification sender.
# Uses the webhook app secret/verify token and Graph version/access token above.
# The token needs messaging and business-management/template-read permissions for these WABAs.
WHATSAPP_INBOX_ENABLED=false
# WHATSAPP_INBOX_CHANNELS_JSON=[{"organisationId":"00000000-0000-4000-8000-000000000001","senderId":"9999","businessId":"5678"}]

# Additional generic notices for reviewed bulk session changes. API queues; worker sends.
WHATSAPP_OPERATIONS_ENABLED=false
# Approved UTILITY template with BODY parameters: 1) clinic name 2) patient portal login URL.
# No patient name, clinical reason, delay estimate or financial data is sent to Meta.
# WHATSAPP_OPERATION_TEMPLATE=clinic_appointment_update
# WHATSAPP_OPERATION_TEMPLATE_LANGUAGE=en

# Staff and platform login policies, independently: totp (default), whatsapp, disabled.
# disabled = password-only. Never chosen by an unauthenticated browser.
STAFF_MFA_MODE=totp
PLATFORM_MFA_MODE=totp
# Optional staff email-to-mobile overrides; otherwise the account's stored phone is used.
STAFF_MFA_PHONES_JSON=
# Required in WhatsApp mode for each platform operator (account email -> Indian mobile).
PLATFORM_MFA_PHONES_JSON=

# Staff contact verification email: TLS SMTP, disabled until configured.
STAFF_EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional review invitations; disabled until an approved neutral Meta template is ready.
WHATSAPP_REVIEWS_ENABLED=false
# WHATSAPP_REVIEW_LINK_SECRET=<shared-api-worker-random-secret-at-least-32-characters>
# WHATSAPP_REVIEW_TEMPLATE=clinic_review_request
# WHATSAPP_REVIEW_TEMPLATE_LANGUAGE=en
