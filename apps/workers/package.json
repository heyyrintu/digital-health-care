{
  "name": "@dhc/workers",
  "version": "0.0.0",
  "private": true,
  "description": "Background workers (BullMQ): messages, PDFs, ABDM, imports, webhooks, reconciliation.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dhc/contracts": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5",
    "@dhc/db": "workspace:*",
    "@dhc/secure-links": "workspace:*",
    "@dhc/cashfree": "workspace:*",
    "@dhc/reconciliation": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@dhc/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
