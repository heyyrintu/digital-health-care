{
  "name": "@dhc/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Patient app and Clinic app from one Expo codebase (ADR 0003, ADR 0004).",
  "main": "expo-router/entry",
  "scripts": {
    "start:patient": "APP_VARIANT=patient expo start",
    "start:clinic": "APP_VARIANT=clinic expo start",
    "bundle": "expo export --platform ios --platform android --output-dir dist/${APP_VARIANT:-patient}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dhc/api-client": "workspace:*",
    "@dhc/contracts": "workspace:*",
    "@dhc/domain": "workspace:*",
    "@dhc/i18n": "workspace:*",
    "@dhc/tokens": "workspace:*",
    "@dhc/ui-native": "workspace:*",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dhc/config": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7"
  }
}
