// Tenancy: every tenant table carries organisation_id and is protected by Postgres
// row-level security (see migrations and ADR 0014). Platform-level tables (users,
// sessions, otp_challenges) are only reachable through the system connection.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Load `include`d relations in one SQL query. Without it Prisma fetches each relation
  // as its own query, all at once, and a transaction is one connection, which runs one
  // query at a time (pg warns about this).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum OrganisationStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum Role {
  patient
  doctor
  front_desk
  clinic_admin
}

enum InvitePurpose {
  /// Joining the organisation: completing it activates the invited membership.
  join
  /// Authenticator reset by a clinic admin: the membership stays active.
  reset
}

enum Gender {
  female
  male
  other
}

enum Language {
  en
  hi
}

enum ConsultationMode {
  in_person
  audio
  video
}

enum AvailabilityExceptionType {
  leave
  holiday
  extra_session
}

/// PRD §5.2. Rescheduled links to the new appointment.
enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_consultation
  completed
  cancelled
  no_show
  rescheduled
}

enum AppointmentSource {
  front_desk
  walk_in
  app
  web
}

/// Who supplied a chart entry. Patient-reported entries are checked but labelled
/// unverified until a doctor confirms them (safety rule SR-21).
enum ChartSource {
  doctor
  patient
}

enum PregnancyStatus {
  not_pregnant
  pregnant
  breastfeeding
}

/// Where a medicine comes from: the platform's reference master (the licensed drug
/// database; a synthetic sample in development) or added by the clinic.
enum MedicineSource {
  reference
  clinic
}

enum MedicineRoute {
  oral
  topical
  inhaled
  eye
  ear
  nasal
  injection
  other
}

enum DoseTiming {
  after_food
  before_food
  with_food
  empty_stomach
  bedtime
}

/// Drafts only for now; signing, amendment and voiding arrive with the signing slice.
enum PrescriptionStatus {
  draft
  signed
  void
}

/// Phase 1 bill states (PRD §5.6). Link sent, refund pending and refunded arrive with
/// Cashfree in Phase 3.
enum BillStatus {
  due
  partly_paid
  paid
}

enum BillLineKind {
  consultation
  follow_up
  item
}

/// Counter payments recorded by staff (PRD §5.6). Online modes arrive with Cashfree.
enum PaymentMode {
  cash
  upi
  card
}

enum MembershipStatus {
  /// Created by a staff invite; becomes active when the invite is completed.
  invited
  active
  revoked
}

model Organisation {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  status    OrganisationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships            Membership[]
  patients               Patient[]
  sessions               Session[]
  invites                StaffInvite[]
  uhidSettings           UhidSettings?
  tags                   Tag[]
  patientTags            PatientTag[]
  clinics                Clinic[]
  consultationTypes      ConsultationType[]
  bookingRules           BookingRules?
  availabilityVersions   AvailabilityVersion[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  appointmentHistory     AppointmentStatusHistory[]
  displayScreens         DisplayScreen[]
  allergies              Allergy[]
  conditions             MedicalCondition[]
  medications            CurrentMedication[]
  vitals                 Vitals[]
  consultations          Consultation[]
  medicines              Medicine[]
  prescriptions          Prescription[]
  prescriptionItems      PrescriptionItem[]
  prescriptionTemplates  PrescriptionTemplate[]
  priceListItems         PriceListItem[]
  bills                  Bill[]
  billItems              BillItem[]
  payments               Payment[]
  receiptSettings        ReceiptSettings?

  @@map("organisations")
}

/// Platform-level login identity. Phone for patients (OTP), email/phone + password + TOTP for staff.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  phone            String?    @unique
  email            String?    @unique
  displayName      String?    @map("display_name")
  status           UserStatus @default(active)
  passwordHash     String?    @map("password_hash")
  /// AES-256-GCM encrypted TOTP secret (confirmed).
  mfaSecret        String?    @map("mfa_secret")
  /// AES-256-GCM encrypted TOTP secret awaiting first-code confirmation.
  mfaPendingSecret String?    @map("mfa_pending_secret")
  /// Last accepted TOTP time step; a code is never accepted twice.
  mfaLastUsedStep  Int?       @map("mfa_last_used_step")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  invites     StaffInvite[]

  @@map("users")
}

/// A user's role in one organisation. The auth link between users and tenants.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           Role
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId, role])
  @@index([userId])
  @@map("memberships")
}

/// Refresh-token session on one device. Tokens are stored as SHA-256 hashes only.
model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  role                     Role
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  userAgent                String?   @map("user_agent")
  ip                       String?
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Single-use link a clinic admin sends to a new staff member. The only way to set a staff
/// password and enrol an authenticator. Only a hash of the token is stored.
model StaffInvite {
  id              String        @id @default(uuid()) @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  role            Role
  purpose         InvitePurpose @default(join)
  tokenHash       String        @unique @map("token_hash")
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organisationId, createdAt])
  @@map("staff_invites")
}

/// Patient sign-in code. Only a hash of the code is stored.
model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String
  organisationId String    @map("organisation_id") @db.Uuid
  codeHash       String    @map("code_hash")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// Person receiving care. Minimal Phase 0 shape; full fields in docs/data/data-dictionary.md.
model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid
  accountUserId         String?   @map("account_user_id") @db.Uuid
  uhid                  String
  name                  String
  /// E.164. Family members may share one number (one account, several patients).
  phone                 String?
  dob                   DateTime? @db.Date
  gender                Gender?
  email                 String?
  address               String?
  bloodGroup            String?   @map("blood_group")
  language              Language  @default(en)
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  /// Under-18s (or anyone without a phone) are linked to the adult who looks after them.
  guardianPatientId     String?   @map("guardian_patient_id") @db.Uuid
  createdByUserId       String?   @map("created_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation        @relation(fields: [organisationId], references: [id])
  guardian     Patient?            @relation("Guardian", fields: [guardianPatientId], references: [id])
  dependants   Patient[]           @relation("Guardian")
  tags         PatientTag[]
  appointments Appointment[]
  allergies    Allergy[]
  conditions   MedicalCondition[]
  medications  CurrentMedication[]

  @@unique([organisationId, uhid])
  @@index([organisationId, phone])
  @@index([guardianPatientId])
  @@map("patients")
}

/// Per-organisation UHID numbering, e.g. prefix "EK" from 10001 gives EK10001.
model UhidSettings {
  organisationId String   @id @map("organisation_id") @db.Uuid
  prefix         String   @default("")
  nextNumber     Int      @default(1) @map("next_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("uhid_settings")
}

/// Configurable patient label (Priority, Emergency, VIP, ...).
model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  /// `#rrggbb`
  colour         String
  /// Emergency and Priority can sort patients to the top of the queue.
  sortToTop      Boolean   @default(false) @map("sort_to_top")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patients     PatientTag[]

  @@unique([organisationId, name])
  @@map("tags")
}

model PatientTag {
  organisationId String   @map("organisation_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  tag          Tag          @relation(fields: [tagId], references: [id])

  @@id([patientId, tagId])
  @@index([organisationId, tagId])
  @@map("patient_tags")
}

/// Physical location where doctors consult.
model Clinic {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  /// Only Asia/Kolkata is supported for now (no daylight saving).
  timezone       String   @default("Asia/Kolkata")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation           Organisation            @relation(fields: [organisationId], references: [id])
  availabilityVersions   AvailabilityVersion[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  displayScreens         DisplayScreen[]

  @@unique([organisationId, name])
  @@map("clinics")
}

/// How a patient is seen, for how long and at what fee (amounts in paise).
model ConsultationType {
  id                 String           @id @default(uuid()) @db.Uuid
  organisationId     String           @map("organisation_id") @db.Uuid
  name               String
  mode               ConsultationMode
  defaultDurationMin Int              @map("default_duration_min")
  feePaise           Int              @map("fee_paise")
  followUpFeePaise   Int?             @map("follow_up_fee_paise")
  requiresPrepayment Boolean          @default(false) @map("requires_prepayment")
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation           Organisation            @relation(fields: [organisationId], references: [id])
  availabilityVersions   AvailabilityVersion[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]

  @@unique([organisationId, name])
  @@map("consultation_types")
}

/// Per-organisation booking window (PRD §4.3). More rules arrive with appointments.
model BookingRules {
  organisationId       String   @id @map("organisation_id") @db.Uuid
  horizonDays          Int      @default(30) @map("horizon_days")
  sameDayCutoffMinutes Int      @default(60) @map("same_day_cutoff_minutes")
  /// Staff may book this many extra patients into taken slots per doctor per day.
  overbookPerDay       Int      @default(2) @map("overbook_per_day")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("booking_rules")
}

/// A doctor's weekly schedule for one clinic and consultation type, from a date onwards.
/// Never edited once in force: a change is a new version with a later effectiveFrom.
model AvailabilityVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  organisationId     String   @map("organisation_id") @db.Uuid
  doctorUserId       String   @map("doctor_user_id") @db.Uuid
  clinicId           String   @map("clinic_id") @db.Uuid
  consultationTypeId String   @map("consultation_type_id") @db.Uuid
  effectiveFrom      DateTime @map("effective_from") @db.Date
  /// `{ mon: [{ start: "10:00", end: "13:00" }], ... }`, IST wall-clock.
  weekly             Json
  slotMinutes        Int      @map("slot_minutes")
  bufferMinutes      Int      @default(0) @map("buffer_minutes")
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation     Organisation     @relation(fields: [organisationId], references: [id])
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  consultationType ConsultationType @relation(fields: [consultationTypeId], references: [id])

  @@unique([doctorUserId, clinicId, consultationTypeId, effectiveFrom])
  @@index([organisationId, doctorUserId])
  @@map("availability_versions")
}

/// Leave (a doctor), a holiday (a whole clinic) or an extra session.
model AvailabilityException {
  id                 String                    @id @default(uuid()) @db.Uuid
  organisationId     String                    @map("organisation_id") @db.Uuid
  type               AvailabilityExceptionType
  /// Null for a clinic-wide holiday.
  doctorUserId       String?                   @map("doctor_user_id") @db.Uuid
  /// Null for leave (the doctor is away from every clinic).
  clinicId           String?                   @map("clinic_id") @db.Uuid
  /// Extra sessions only.
  consultationTypeId String?                   @map("consultation_type_id") @db.Uuid
  startDate          DateTime                  @map("start_date") @db.Date
  endDate            DateTime                  @map("end_date") @db.Date
  startTime          String?                   @map("start_time")
  endTime            String?                   @map("end_time")
  reason             String?
  createdByUserId    String                    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation     Organisation      @relation(fields: [organisationId], references: [id])
  // Restrict, not SetNull: an empty clinic means "every clinic", so a deleted clinic
  // must never widen a holiday.
  clinic           Clinic?           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  consultationType ConsultationType? @relation(fields: [consultationTypeId], references: [id], onDelete: Restrict)

  @@index([organisationId, startDate])
  @@map("availability_exceptions")
}

/// Append-only audit trail. Updates and deletes are blocked by a trigger.
/// A booking or walk-in (PRD §4.3, §5). Times are instants; `date` is the IST day the
/// queue and token belong to.
model Appointment {
  id                    String            @id @default(uuid()) @db.Uuid
  organisationId        String            @map("organisation_id") @db.Uuid
  patientId             String            @map("patient_id") @db.Uuid
  doctorUserId          String            @map("doctor_user_id") @db.Uuid
  clinicId              String            @map("clinic_id") @db.Uuid
  consultationTypeId    String            @map("consultation_type_id") @db.Uuid
  date                  DateTime          @db.Date
  startAt               DateTime          @map("start_at") @db.Timestamptz(3)
  endAt                 DateTime          @map("end_at") @db.Timestamptz(3)
  status                AppointmentStatus
  source                AppointmentSource
  /// Per doctor, clinic and day, in booking order.
  tokenNumber           Int               @map("token_number")
  /// Booked into a slot that was already taken (staff only, within the daily limit).
  overbook              Boolean           @default(false)
  reason                String?
  cancelReason          String?           @map("cancel_reason")
  rescheduledFromId     String?           @unique @map("rescheduled_from_id") @db.Uuid
  checkedInAt           DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  consultationStartedAt DateTime?         @map("consultation_started_at") @db.Timestamptz(3)
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdByUserId       String            @map("created_by_user_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation     Organisation               @relation(fields: [organisationId], references: [id])
  patient          Patient                    @relation(fields: [patientId], references: [id])
  clinic           Clinic                     @relation(fields: [clinicId], references: [id])
  consultationType ConsultationType           @relation(fields: [consultationTypeId], references: [id])
  rescheduledFrom  Appointment?               @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo    Appointment?               @relation("Reschedule")
  history          AppointmentStatusHistory[]
  vitals           Vitals?
  consultation     Consultation?
  prescriptions    Prescription[]
  bill             Bill?

  @@unique([doctorUserId, clinicId, date, tokenNumber])
  @@index([organisationId, date])
  @@index([doctorUserId, date])
  @@index([patientId])
  @@map("appointments")
}

/// Every status change, with who and when (PRD §5.2). Append-only.
model AppointmentStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  fromStatus     AppointmentStatus? @map("from_status")
  toStatus       AppointmentStatus  @map("to_status")
  actorUserId    String             @map("actor_user_id") @db.Uuid
  note           String?
  at             DateTime           @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@map("appointment_status_history")
}

/// A waiting-room screen (PRD §5.3): a kiosk link showing current and next tokens for
/// one clinic, never names. The link's token is stored as a SHA-256 hash only.
model DisplayScreen {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  clinicId        String    @map("clinic_id") @db.Uuid
  label           String
  tokenHash       String    @unique @map("token_hash")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])

  @@index([organisationId])
  @@map("display_screens")
}

/// A recorded allergy (PRD §6.1). Never deleted: removing one keeps the row with who,
/// when and why, because past prescriptions were checked against it.
model Allergy {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  substance        String
  reaction         String?
  source           ChartSource
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?     @map("removed_by_user_id") @db.Uuid
  removedReason    String?     @map("removed_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("allergies")
}

/// A known condition (diabetes, kidney disease…), optionally ICD-10 coded. Resolved, not
/// deleted.
model MedicalCondition {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  name             String
  icd10Code        String?     @map("icd10_code")
  source           ChartSource
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?     @map("removed_by_user_id") @db.Uuid
  removedReason    String?     @map("removed_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_conditions")
}

/// A medicine the patient already takes (from elsewhere). Stopped, not deleted.
model CurrentMedication {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  name             String
  dose             String?
  source           ChartSource
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?     @map("removed_by_user_id") @db.Uuid
  removedReason    String?     @map("removed_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("current_medications")
}

/// Vitals for one visit (PRD §6.1). Front desk or the doctor records them; one row per
/// appointment, updated in place.
model Vitals {
  id               String           @id @default(uuid()) @db.Uuid
  organisationId   String           @map("organisation_id") @db.Uuid
  appointmentId    String           @unique @map("appointment_id") @db.Uuid
  patientId        String           @map("patient_id") @db.Uuid
  bpSystolic       Int?             @map("bp_systolic")
  bpDiastolic      Int?             @map("bp_diastolic")
  pulse            Int?
  temperatureC     Decimal?         @map("temperature_c") @db.Decimal(4, 1)
  spo2             Int?
  weightKg         Decimal?         @map("weight_kg") @db.Decimal(5, 2)
  heightCm         Decimal?         @map("height_cm") @db.Decimal(5, 1)
  painScore        Int?             @map("pain_score")
  pregnancyStatus  PregnancyStatus? @map("pregnancy_status")
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@map("vitals")
}

/// The doctor's record of a visit (PRD §6.1). The clinical text (complaint, symptoms,
/// examination, diagnoses, plan, notes, advice) is one encrypted JSON document; only
/// the follow-up date and bookkeeping stay in the clear. `revision` guards autosave
/// against a second tab overwriting newer text. Locked once the prescription is signed.
model Consultation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  appointmentId  String    @unique @map("appointment_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  doctorUserId   String    @map("doctor_user_id") @db.Uuid
  notesCipher    String    @map("notes_cipher")
  followUpDate   DateTime? @map("follow_up_date") @db.Date
  revision       Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@map("consultations")
}

/// A molecule from the reference drug data (platform-wide, read-only to clinics). The
/// safety engine reads molecules and classes; drug facts come from the licensed database.
model DrugMolecule {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  drugClass String?  @map("drug_class")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("drug_molecules")
}

/// A medicine doctors can prescribe (PRD §6.4). `organisationId` is null for the
/// platform's reference master and set for medicines a clinic adds.
model Medicine {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String?        @map("organisation_id") @db.Uuid
  name           String
  genericName    String         @map("generic_name")
  composition    String
  form           String
  moleculeIds    String[]       @map("molecule_ids") @db.Uuid
  defaultRoute   MedicineRoute  @default(oral) @map("default_route")
  source         MedicineSource
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("medicines")
}

/// A visit's prescription. One draft per visit; amendments will add versions.
/// `revision` guards autosave like consultation notes.
model Prescription {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  doctorUserId   String             @map("doctor_user_id") @db.Uuid
  version        Int                @default(1)
  status         PrescriptionStatus @default(draft)
  language       Language           @default(en)
  revision       Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation       @relation(fields: [organisationId], references: [id])
  appointment  Appointment        @relation(fields: [appointmentId], references: [id])
  items        PrescriptionItem[]

  @@unique([appointmentId, version])
  @@index([patientId])
  @@map("prescriptions")
}

/// One medicine line. Name and composition are snapshots, so the printed prescription
/// never changes if the master does. `steps` holds dose, frequency and duration, one
/// entry per step of a tapering course. Remarks are generated unless the doctor edited them.
model PrescriptionItem {
  id             String         @id @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  prescriptionId String         @map("prescription_id") @db.Uuid
  medicineId     String?        @map("medicine_id") @db.Uuid
  name           String
  composition    String?
  form           String?
  route          MedicineRoute?
  timing         DoseTiming?
  steps          Json
  quantity       String?
  instructions   String?
  remarks        String
  remarksEdited  Boolean        @default(false) @map("remarks_edited")
  sortOrder      Int            @map("sort_order")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// A doctor's saved set of lines (PRD §6.4 "save as template").
model PrescriptionTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  doctorUserId   String   @map("doctor_user_id") @db.Uuid
  name           String
  items          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, doctorUserId, name])
  @@map("prescription_templates")
}

/// Chargeable services besides the consultation (PRD §5.6): dressing, injection, X-ray
/// review. Never deleted, only deactivated, so old bills keep their meaning.
model PriceListItem {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  pricePaise     Int      @map("price_paise")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  billItems    BillItem[]

  @@unique([organisationId, name])
  @@map("price_list_items")
}

/// One bill per visit (PRD §5.6). Every amount is set by the server; the lines can change
/// until the first payment, then the bill is fixed.
model Bill {
  id              String     @id @default(uuid()) @db.Uuid
  organisationId  String     @map("organisation_id") @db.Uuid
  appointmentId   String     @unique @map("appointment_id") @db.Uuid
  patientId       String     @map("patient_id") @db.Uuid
  doctorUserId    String     @map("doctor_user_id") @db.Uuid
  subtotalPaise   Int        @map("subtotal_paise")
  discountPaise   Int        @default(0) @map("discount_paise")
  discountReason  String?    @map("discount_reason")
  totalPaise      Int        @map("total_paise")
  paidPaise       Int        @default(0) @map("paid_paise")
  status          BillStatus @default(due)
  /// Guards against two people editing the same bill (0 is "no bill yet").
  revision        Int        @default(1)
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  items        BillItem[]
  payments     Payment[]

  @@index([organisationId, createdAt])
  @@index([patientId])
  @@map("bills")
}

model BillItem {
  id              String       @id @default(uuid()) @db.Uuid
  organisationId  String       @map("organisation_id") @db.Uuid
  billId          String       @map("bill_id") @db.Uuid
  kind            BillLineKind
  priceListItemId String?      @map("price_list_item_id") @db.Uuid
  /// The name and price at the time of billing; later price-list changes do not touch it.
  name            String
  unitPaise       Int          @map("unit_paise")
  quantity        Int
  amountPaise     Int          @map("amount_paise")
  sortOrder       Int          @map("sort_order")

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  bill          Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  priceListItem PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@map("bill_items")
}

/// A counter payment and its receipt. The ID comes from the client, so a retried
/// request records the payment once.
model Payment {
  id               String      @id @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  billId           String      @map("bill_id") @db.Uuid
  mode             PaymentMode
  amountPaise      Int         @map("amount_paise")
  /// UPI transaction or card slip reference, as written on the slip.
  reference        String?
  receiptNumber    String      @map("receipt_number")
  receivedByUserId String      @map("received_by_user_id") @db.Uuid
  receivedAt       DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  bill         Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([organisationId, receiptNumber])
  @@index([organisationId, receivedAt])
  @@index([billId])
  @@map("payments")
}

/// Receipt numbering, one row per organisation, advanced inside the payment's transaction.
model ReceiptSettings {
  organisationId String   @id @map("organisation_id") @db.Uuid
  prefix         String   @default("R")
  nextNumber     Int      @default(1) @map("next_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("receipt_settings")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  requestId      String?  @map("request_id")
  ip             String?
  userAgent      String?  @map("user_agent")
  metadata       Json?
  at             DateTime @default(now()) @db.Timestamptz(3)

  @@index([organisationId, at])
  @@map("audit_logs")
}
