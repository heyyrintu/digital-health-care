// Tenancy: every tenant table carries organisation_id and is protected by Postgres
// row-level security (see migrations and ADR 0014). Platform-level tables (users,
// sessions, otp_challenges) are only reachable through the system connection.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Load `include`d relations in one SQL query. Without it Prisma fetches each relation
  // as its own query, all at once, and a transaction is one connection, which runs one
  // query at a time (pg warns about this).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum OrganisationStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum Role {
  patient
  doctor
  front_desk
  clinic_admin
}

enum InvitePurpose {
  /// Joining the organisation: completing it activates the invited membership.
  join
  /// Authenticator reset by a clinic admin: the membership stays active.
  reset
}

enum Gender {
  female
  male
  other
}

enum Language {
  en
  hi
}

enum ConsultationMode {
  in_person
  audio
  video
}

enum AvailabilityExceptionType {
  leave
  holiday
  extra_session
}

/// PRD §5.2. Rescheduled links to the new appointment.
enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_consultation
  completed
  cancelled
  no_show
  rescheduled
}

enum AppointmentSource {
  front_desk
  walk_in
  app
  web
}

/// Who supplied a chart entry. Patient-reported entries are checked but labelled
/// unverified until a doctor confirms them (safety rule SR-21).
enum ChartSource {
  doctor
  patient
}

enum PregnancyStatus {
  not_pregnant
  pregnant
  breastfeeding
}

/// Where a medicine comes from: the platform's reference master (the licensed drug
/// database; a synthetic sample in development) or added by the clinic.
enum MedicineSource {
  reference
  clinic
}

/// Reference drug data for the safety engine (docs/safety). Null means no data.
enum DrugRisk {
  caution
  contraindicated
}

/// Telemedicine Practice Guidelines lists: O (any consultation), A (video first consult),
/// B (follow-up only) and prohibited online.
enum TelemedicineList {
  o
  a
  b
  prohibited
}

enum InteractionSeverity {
  contraindicated
  major
  moderate
  minor
}

/// What a medicine ingredient's strength is per: one dose unit (tablet, capsule, sachet,
/// drop, puff) or one ml of a liquid.
enum StrengthPer {
  unit
  ml
}

enum SafetySeverity {
  block
  warn
  info
}

/// What the doctor did with an alert (PRD §6.5): acknowledged a warning, overrode a block
/// the database allows, or changed the prescription so it no longer fires.
enum SafetyAlertAction {
  acknowledged
  overridden
  changed
}

enum MedicineRoute {
  oral
  topical
  inhaled
  eye
  ear
  nasal
  injection
  other
}

enum DoseTiming {
  after_food
  before_food
  with_food
  empty_stomach
  bedtime
}

/// A draft is edited until signed. A signed version is immutable: an amendment signs a new
/// version and supersedes it; voiding withdraws it.
enum PrescriptionStatus {
  draft
  signed
  superseded
  void
}

/// Set by the platform team after checking the registration (PRD §9.1); only verified
/// doctors can sign.
enum DoctorVerification {
  pending
  verified
}

enum MedicineDecision {
  approved
  rejected
}

enum PaperSize {
  a4
  a5
}

/// Phase 1 bill states (PRD §5.6). Link sent, refund pending and refunded arrive with
/// Cashfree in Phase 3.
enum BillStatus {
  due
  partly_paid
  paid
}

enum BillLineKind {
  consultation
  follow_up
  item
}

/// Counter payments recorded by staff (PRD §5.6). Online modes arrive with Cashfree.
enum PaymentMode {
  cash
  upi
  card
}

/// Test orders (PRD §7.1): what kind of test, which side of the body for imaging, and
/// where the order is: ordered (printed on a signed prescription), a result uploaded, or
/// reviewed by a doctor.
enum TestKind {
  blood
  xray
  mri
  ct
  other
}

enum TestSide {
  left
  right
  both
  /// Not applicable: a blood test, or a region with no side (brain, chest).
  na
}

enum TestOrderStatus {
  ordered
  result_uploaded
  reviewed
}

/// internal: to a doctor of the same organisation; external: to someone outside it.
enum ReferralKind {
  internal
  external
}

enum ReferralUrgency {
  routine
  soon
  urgent
}

/// sent → seen (the receiving doctor opened it; internal only) → closed. Forward only.
enum ReferralStatus {
  sent
  seen
  closed
}

/// What a clinic library sheet or a shared document is about (PRD §7.3).
enum DocumentCategory {
  exercise
  diet
  information
  other
}

/// The language a document is written in: English, Hindi or another.
enum DocumentLanguage {
  en
  hi
  other
}

/// Where a shared document came from: the clinic library or a one-off upload.
enum PatientDocumentSource {
  library
  upload
}

enum MembershipStatus {
  /// Created by a staff invite; becomes active when the invite is completed.
  invited
  active
  revoked
}

model Organisation {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  status    OrganisationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships            Membership[]
  patients               Patient[]
  sessions               Session[]
  pushDevices            PushDevice[]
  invites                StaffInvite[]
  uhidSettings           UhidSettings?
  tags                   Tag[]
  patientTags            PatientTag[]
  clinics                Clinic[]
  consultationTypes      ConsultationType[]
  bookingRules           BookingRules?
  availabilityVersions   AvailabilityVersion[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  appointmentHistory     AppointmentStatusHistory[]
  displayScreens         DisplayScreen[]
  allergies              Allergy[]
  conditions             MedicalCondition[]
  medications            CurrentMedication[]
  vitals                 Vitals[]
  consultations          Consultation[]
  medicines              Medicine[]
  prescriptions          Prescription[]
  prescriptionItems      PrescriptionItem[]
  prescriptionTemplates  PrescriptionTemplate[]
  priceListItems         PriceListItem[]
  bills                  Bill[]
  billItems              BillItem[]
  payments               Payment[]
  receiptSettings        ReceiptSettings?
  idempotencyKeys        IdempotencyKey[]
  settings               OrganisationSettings?
  branding               OrganisationBranding?
  safetyAlerts           SafetyAlert[]
  doctorProfiles         DoctorProfile[]
  medicineRequests       MedicineRequest[]
  verifications          PrescriptionVerification[]
  patientMergeRequests   PatientMergeRequest[]
  accountConsents        AccountConsent[]
  testCatalogueItems     TestCatalogueItem[]
  testOrders             TestOrder[]
  testResults            TestResult[]
  referrals              Referral[]
  referralLetters        ReferralLetter[]
  referralLetterChecks   ReferralLetterVerification[]
  documentFiles          DocumentFile[]
  libraryDocuments       LibraryDocument[]
  patientDocuments       PatientDocument[]

  @@map("organisations")
}

/// Platform-level login identity. Phone for patients (OTP), email/phone + password + TOTP for staff.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  phone            String?    @unique
  email            String?    @unique
  displayName      String?    @map("display_name")
  status           UserStatus @default(active)
  passwordHash     String?    @map("password_hash")
  /// AES-256-GCM encrypted TOTP secret (confirmed).
  mfaSecret        String?    @map("mfa_secret")
  /// AES-256-GCM encrypted TOTP secret awaiting first-code confirmation.
  mfaPendingSecret String?    @map("mfa_pending_secret")
  /// Last accepted TOTP time step; a code is never accepted twice.
  mfaLastUsedStep  Int?       @map("mfa_last_used_step")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  pushDevices PushDevice[]
  invites     StaffInvite[]
  consents    AccountConsent[]

  @@map("users")
}

/// A user's role in one organisation. The auth link between users and tenants.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           Role
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId, role])
  @@index([userId])
  @@map("memberships")
}

/// Refresh-token session on one device. Tokens are stored as SHA-256 hashes only.
model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  role                     Role
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  userAgent                String?   @map("user_agent")
  ip                       String?
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  pushDevices  PushDevice[]

  @@index([userId])
  @@map("sessions")
}

enum DevicePlatform {
  ios
  android
}

enum AppVariant {
  clinic
  patient
}

/// A phone or tablet that receives push notifications for one signed-in session. One row
/// per Expo push token: signing in on the device again moves the row to the new session.
/// Platform-level like sessions (auth role only); it stops receiving when its session
/// ends or it is removed.
model PushDevice {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  sessionId      String         @map("session_id") @db.Uuid
  platform       DevicePlatform
  appVariant     AppVariant     @map("app_variant")
  expoPushToken  String         @unique @map("expo_push_token")
  deviceName     String?        @map("device_name")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?        @map("revoked_reason")

  user         User         @relation(fields: [userId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  session      Session      @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@map("push_devices")
}

/// Single-use link a clinic admin sends to a new staff member. The only way to set a staff
/// password and enrol an authenticator. Only a hash of the token is stored.
model StaffInvite {
  id              String        @id @default(uuid()) @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  role            Role
  purpose         InvitePurpose @default(join)
  tokenHash       String        @unique @map("token_hash")
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organisationId, createdAt])
  @@map("staff_invites")
}

/// Patient sign-in code. Only a hash of the code is stored.
model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String
  organisationId String    @map("organisation_id") @db.Uuid
  codeHash       String    @map("code_hash")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// Person receiving care. Minimal Phase 0 shape; full fields in docs/data/data-dictionary.md.
enum PatientMergeStatus {
  pending
  approved
  rejected
}

/// A request to merge a duplicate patient record (source) into the one that stays (target).
/// Front desk, doctors and clinic admins ask; a clinic admin approves or rejects.
model PatientMergeRequest {
  id                String             @id @default(uuid()) @db.Uuid
  organisationId    String             @map("organisation_id") @db.Uuid
  sourcePatientId   String             @map("source_patient_id") @db.Uuid
  targetPatientId   String             @map("target_patient_id") @db.Uuid
  reason            String
  status            PatientMergeStatus @default(pending)
  requestedByUserId String             @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId   String?            @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?            @map("decision_note")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  source       Patient      @relation("MergeSource", fields: [sourcePatientId], references: [id], onDelete: Restrict)
  target       Patient      @relation("MergeTarget", fields: [targetPatientId], references: [id], onDelete: Restrict)

  @@index([organisationId, status])
  @@index([sourcePatientId])
  @@index([targetPatientId])
  @@map("patient_merge_requests")
}

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid
  accountUserId         String?   @map("account_user_id") @db.Uuid
  uhid                  String
  name                  String
  /// E.164. Family members may share one number (one account, several patients).
  phone                 String?
  dob                   DateTime? @db.Date
  gender                Gender?
  email                 String?
  address               String?
  bloodGroup            String?   @map("blood_group")
  language              Language  @default(en)
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  /// Under-18s (or anyone without a phone) are linked to the adult who looks after them.
  guardianPatientId     String?   @map("guardian_patient_id") @db.Uuid
  /// Set when a clinic admin merged this duplicate into another record; the record is then
  /// read-only and its history shows under the kept one.
  mergedIntoId          String?   @map("merged_into_id") @db.Uuid
  mergedAt              DateTime? @map("merged_at") @db.Timestamptz(3)
  createdByUserId       String?   @map("created_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  guardian     Patient?              @relation("Guardian", fields: [guardianPatientId], references: [id])
  dependants   Patient[]             @relation("Guardian")
  mergedInto   Patient?              @relation("Merge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Patient[]             @relation("Merge")
  mergeSources PatientMergeRequest[] @relation("MergeSource")
  mergeTargets PatientMergeRequest[] @relation("MergeTarget")
  tags         PatientTag[]
  appointments Appointment[]
  allergies    Allergy[]
  conditions   MedicalCondition[]
  medications  CurrentMedication[]
  referrals    Referral[]
  documents    PatientDocument[]

  @@unique([organisationId, uhid])
  @@index([organisationId, phone])
  @@index([guardianPatientId])
  @@index([mergedIntoId])
  @@map("patients")
}

/// Per-organisation UHID numbering, e.g. prefix "EK" from 10001 gives EK10001.
model UhidSettings {
  organisationId String   @id @map("organisation_id") @db.Uuid
  prefix         String   @default("")
  nextNumber     Int      @default(1) @map("next_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("uhid_settings")
}

/// Clinic admin settings (PRD §9.2), one row per organisation; no row means the defaults.
model OrganisationSettings {
  organisationId    String   @id @map("organisation_id") @db.Uuid
  /// shared: every doctor sees the full chart. own_patients: a doctor sees a patient's
  /// chart once the patient has been checked in to them, or while an internal referral of
  /// the patient to them is open (PRD §3.2, §7.2).
  chartModel        String   @default("shared") @map("chart_model")
  /// Non-critical safety rules hidden from doctors (catalogue "Visibility only" rules).
  hiddenSafetyRules String[] @default([]) @map("hidden_safety_rules")
  maxUploadMb       Int      @default(10) @map("max_upload_mb")
  uploadTypes       String[] @default(["pdf", "jpeg", "png"]) @map("upload_types")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("organisation_settings")
}

/// The organisation's branding (Build Plan §5.1), one row per organisation; no row means the
/// platform look. Published to anonymous visitors only through the `public_organisation_*`
/// and `public_doctor_directory` functions (ADR 0017 addendum 2), so it has its own table.
model OrganisationBranding {
  organisationId String   @id @map("organisation_id") @db.Uuid
  /// 1–80 characters; shown instead of the organisation's name on public pages.
  displayName    String?  @map("display_name")
  /// #rrggbb, lowercase, with at least 4.5:1 contrast with white text (checked by the API).
  accentColour   String?  @map("accent_colour")
  /// Up to 120 characters, shown on the portal's sign-in.
  tagline        String?
  /// The logo in the file store: key, media type (PNG, JPEG or WebP), size and SHA-256.
  logoKey        String?  @map("logo_key")
  logoMediaType  String?  @map("logo_media_type")
  logoSizeBytes  Int?     @map("logo_size_bytes")
  logoSha256     String?  @map("logo_sha256")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([logoSha256])
  @@map("organisation_branding")
}

/// Configurable patient label (Priority, Emergency, VIP, ...).
model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  /// `#rrggbb`
  colour         String
  /// Emergency and Priority can sort patients to the top of the queue.
  sortToTop      Boolean   @default(false) @map("sort_to_top")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patients     PatientTag[]

  @@unique([organisationId, name])
  @@map("tags")
}

model PatientTag {
  organisationId String   @map("organisation_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  tag          Tag          @relation(fields: [tagId], references: [id])

  @@id([patientId, tagId])
  @@index([organisationId, tagId])
  @@map("patient_tags")
}

/// Physical location where doctors consult.
model Clinic {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  /// Only Asia/Kolkata is supported for now (no daylight saving).
  timezone       String   @default("Asia/Kolkata")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation           Organisation            @relation(fields: [organisationId], references: [id])
  availabilityVersions   AvailabilityVersion[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  displayScreens         DisplayScreen[]

  @@unique([organisationId, name])
  @@map("clinics")
}

/// How a patient is seen, for how long and at what fee (amounts in paise).
model ConsultationType {
  id                 String           @id @default(uuid()) @db.Uuid
  organisationId     String           @map("organisation_id") @db.Uuid
  name               String
  mode               ConsultationMode
  defaultDurationMin Int              @map("default_duration_min")
  feePaise           Int              @map("fee_paise")
  followUpFeePaise   Int?             @map("follow_up_fee_paise")
  requiresPrepayment Boolean          @default(false) @map("requires_prepayment")
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation           Organisation            @relation(fields: [organisationId], references: [id])
  availabilityVersions   AvailabilityVersion[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]

  @@unique([organisationId, name])
  @@map("consultation_types")
}

/// Per-organisation booking window (PRD §4.3). More rules arrive with appointments.
model BookingRules {
  organisationId       String   @id @map("organisation_id") @db.Uuid
  horizonDays          Int      @default(30) @map("horizon_days")
  sameDayCutoffMinutes Int      @default(60) @map("same_day_cutoff_minutes")
  /// Staff may book this many extra patients into taken slots per doctor per day.
  overbookPerDay       Int      @default(2) @map("overbook_per_day")
  /// Patient self-booking (PRD §4.3): upcoming bookings per patient, the no-show block,
  /// how late a patient may cancel, and whether bookings wait for the front desk.
  maxActiveBookings    Int      @default(2) @map("max_active_bookings")
  noShowLimit          Int      @default(3) @map("no_show_limit")
  noShowWindowDays     Int      @default(90) @map("no_show_window_days")
  cancelCutoffMinutes  Int      @default(120) @map("cancel_cutoff_minutes")
  autoConfirm          Boolean  @default(true) @map("auto_confirm")
  /// Bookings nobody arrived for become no-shows this many minutes after the slot ends;
  /// null switches automatic no-shows off.
  noShowAfterMinutes   Int?     @default(30) @map("no_show_after_minutes")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("booking_rules")
}

/// A doctor's weekly schedule for one clinic and consultation type, from a date onwards.
/// Never edited once in force: a change is a new version with a later effectiveFrom.
model AvailabilityVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  organisationId     String   @map("organisation_id") @db.Uuid
  doctorUserId       String   @map("doctor_user_id") @db.Uuid
  clinicId           String   @map("clinic_id") @db.Uuid
  consultationTypeId String   @map("consultation_type_id") @db.Uuid
  effectiveFrom      DateTime @map("effective_from") @db.Date
  /// `{ mon: [{ start: "10:00", end: "13:00" }], ... }`, IST wall-clock.
  weekly             Json
  slotMinutes        Int      @map("slot_minutes")
  bufferMinutes      Int      @default(0) @map("buffer_minutes")
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation     Organisation     @relation(fields: [organisationId], references: [id])
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  consultationType ConsultationType @relation(fields: [consultationTypeId], references: [id])

  @@unique([doctorUserId, clinicId, consultationTypeId, effectiveFrom])
  @@index([organisationId, doctorUserId])
  @@map("availability_versions")
}

/// Leave (a doctor), a holiday (a whole clinic) or an extra session.
model AvailabilityException {
  id                 String                    @id @default(uuid()) @db.Uuid
  organisationId     String                    @map("organisation_id") @db.Uuid
  type               AvailabilityExceptionType
  /// Null for a clinic-wide holiday.
  doctorUserId       String?                   @map("doctor_user_id") @db.Uuid
  /// Null for leave (the doctor is away from every clinic).
  clinicId           String?                   @map("clinic_id") @db.Uuid
  /// Extra sessions only.
  consultationTypeId String?                   @map("consultation_type_id") @db.Uuid
  startDate          DateTime                  @map("start_date") @db.Date
  endDate            DateTime                  @map("end_date") @db.Date
  startTime          String?                   @map("start_time")
  endTime            String?                   @map("end_time")
  reason             String?
  createdByUserId    String                    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation     Organisation      @relation(fields: [organisationId], references: [id])
  // Restrict, not SetNull: an empty clinic means "every clinic", so a deleted clinic
  // must never widen a holiday.
  clinic           Clinic?           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  consultationType ConsultationType? @relation(fields: [consultationTypeId], references: [id], onDelete: Restrict)

  @@index([organisationId, startDate])
  @@map("availability_exceptions")
}

/// Append-only audit trail. Updates and deletes are blocked by a trigger.
/// A booking or walk-in (PRD §4.3, §5). Times are instants; `date` is the IST day the
/// queue and token belong to.
model Appointment {
  id                    String            @id @default(uuid()) @db.Uuid
  organisationId        String            @map("organisation_id") @db.Uuid
  patientId             String            @map("patient_id") @db.Uuid
  doctorUserId          String            @map("doctor_user_id") @db.Uuid
  clinicId              String            @map("clinic_id") @db.Uuid
  consultationTypeId    String            @map("consultation_type_id") @db.Uuid
  date                  DateTime          @db.Date
  startAt               DateTime          @map("start_at") @db.Timestamptz(3)
  endAt                 DateTime          @map("end_at") @db.Timestamptz(3)
  status                AppointmentStatus
  source                AppointmentSource
  /// Per doctor, clinic and day, in booking order.
  tokenNumber           Int               @map("token_number")
  /// Booked into a slot that was already taken (staff only, within the daily limit).
  overbook              Boolean           @default(false)
  reason                String?
  cancelReason          String?           @map("cancel_reason")
  rescheduledFromId     String?           @unique @map("rescheduled_from_id") @db.Uuid
  checkedInAt           DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  consultationStartedAt DateTime?         @map("consultation_started_at") @db.Timestamptz(3)
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdByUserId       String            @map("created_by_user_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation     Organisation               @relation(fields: [organisationId], references: [id])
  patient          Patient                    @relation(fields: [patientId], references: [id])
  clinic           Clinic                     @relation(fields: [clinicId], references: [id])
  consultationType ConsultationType           @relation(fields: [consultationTypeId], references: [id])
  rescheduledFrom  Appointment?               @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo    Appointment?               @relation("Reschedule")
  history          AppointmentStatusHistory[]
  vitals           Vitals?
  consultation     Consultation?
  prescriptions    Prescription[]
  bill             Bill?
  testOrders       TestOrder[]
  referrals        Referral[]
  documents        PatientDocument[]

  @@unique([doctorUserId, clinicId, date, tokenNumber])
  @@index([organisationId, date])
  @@index([doctorUserId, date])
  @@index([patientId])
  @@map("appointments")
}

/// Every status change, with who and when (PRD §5.2). Append-only.
model AppointmentStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  fromStatus     AppointmentStatus? @map("from_status")
  toStatus       AppointmentStatus  @map("to_status")
  /// Null for automatic changes (a booking nobody arrived for becoming a no-show).
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  note           String?
  at             DateTime           @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@map("appointment_status_history")
}

/// A waiting-room screen (PRD §5.3): a kiosk link showing current and next tokens for
/// one clinic, never names. The link's token is stored as a SHA-256 hash only.
model DisplayScreen {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  clinicId        String    @map("clinic_id") @db.Uuid
  label           String
  tokenHash       String    @unique @map("token_hash")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])

  @@index([organisationId])
  @@map("display_screens")
}

/// A recorded allergy (PRD §6.1). Never deleted: removing one keeps the row with who,
/// when and why, because past prescriptions were checked against it.
model Allergy {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  substance        String
  reaction         String?
  source           ChartSource
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?     @map("removed_by_user_id") @db.Uuid
  removedReason    String?     @map("removed_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("allergies")
}

/// A known condition (diabetes, kidney disease…), optionally ICD-10 coded. Resolved, not
/// deleted.
model MedicalCondition {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  name             String
  icd10Code        String?     @map("icd10_code")
  source           ChartSource
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?     @map("removed_by_user_id") @db.Uuid
  removedReason    String?     @map("removed_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_conditions")
}

/// A medicine the patient already takes (from elsewhere). Stopped, not deleted.
model CurrentMedication {
  id               String      @id @default(uuid()) @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  name             String
  dose             String?
  source           ChartSource
  recordedByUserId String      @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt        DateTime?   @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?     @map("removed_by_user_id") @db.Uuid
  removedReason    String?     @map("removed_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("current_medications")
}

/// Vitals for one visit (PRD §6.1). Front desk or the doctor records them; one row per
/// appointment, updated in place.
model Vitals {
  id               String           @id @default(uuid()) @db.Uuid
  organisationId   String           @map("organisation_id") @db.Uuid
  appointmentId    String           @unique @map("appointment_id") @db.Uuid
  patientId        String           @map("patient_id") @db.Uuid
  bpSystolic       Int?             @map("bp_systolic")
  bpDiastolic      Int?             @map("bp_diastolic")
  pulse            Int?
  temperatureC     Decimal?         @map("temperature_c") @db.Decimal(4, 1)
  spo2             Int?
  weightKg         Decimal?         @map("weight_kg") @db.Decimal(5, 2)
  heightCm         Decimal?         @map("height_cm") @db.Decimal(5, 1)
  painScore        Int?             @map("pain_score")
  pregnancyStatus  PregnancyStatus? @map("pregnancy_status")
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@map("vitals")
}

/// The doctor's record of a visit (PRD §6.1). The clinical text (complaint, symptoms,
/// examination, diagnoses, plan, notes, advice) is one encrypted JSON document; only
/// the follow-up date and bookkeeping stay in the clear. `revision` guards autosave
/// against a second tab overwriting newer text. Locked once the prescription is signed.
model Consultation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  appointmentId  String    @unique @map("appointment_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  doctorUserId   String    @map("doctor_user_id") @db.Uuid
  notesCipher    String    @map("notes_cipher")
  followUpDate   DateTime? @map("follow_up_date") @db.Date
  revision       Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([organisationId, followUpDate])
  @@index([patientId])
  @@map("consultations")
}

/// A molecule from the reference drug data (platform-wide, read-only to clinics). The
/// safety engine reads molecules and classes; drug facts come from the licensed database.
model DrugMolecule {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String            @unique
  drugClass            String?           @map("drug_class")
  pregnancy            DrugRisk?
  /// Whether a pregnancy contraindication may be overridden with a reason (SR-10).
  pregnancyOverridable Boolean           @default(false) @map("pregnancy_overridable")
  lactation            DrugRisk?
  /// Dosed by weight in children; needs today's weight under 12 (SR-12).
  weightBased          Boolean           @default(false) @map("weight_based")
  childMinMgPerKgDay   Decimal?          @map("child_min_mg_per_kg_day") @db.Decimal(8, 2)
  childMaxMgPerKgDay   Decimal?          @map("child_max_mg_per_kg_day") @db.Decimal(8, 2)
  childDoseOverridable Boolean           @default(true) @map("child_dose_overridable")
  /// Adult (12 and over) maximum per day, across all lines (SR-14).
  maxDailyMg           Decimal?          @map("max_daily_mg") @db.Decimal(10, 2)
  maxDoseOverridable   Boolean           @default(true) @map("max_dose_overridable")
  olderAdultCaution    Boolean           @default(false) @map("older_adult_caution")
  renalAdjustment      Boolean           @default(false) @map("renal_adjustment")
  hepaticCaution       Boolean           @default(false) @map("hepatic_caution")
  telemedicineList     TelemedicineList? @map("telemedicine_list")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  ingredients    MedicineIngredient[]
  interactionsA  DrugInteraction[]    @relation("InteractionA")
  interactionsB  DrugInteraction[]    @relation("InteractionB")
  conditionRules DrugConditionRule[]

  @@map("drug_molecules")
}

/// A pair of molecules that interact (SR-04 to SR-06). Stored once, with A's ID before B's.
model DrugInteraction {
  id          String              @id @default(uuid()) @db.Uuid
  moleculeAId String              @map("molecule_a_id") @db.Uuid
  moleculeBId String              @map("molecule_b_id") @db.Uuid
  severity    InteractionSeverity
  /// For contraindicated pairs: whether the database allows an override with a reason.
  overridable Boolean             @default(false)
  note        String?

  moleculeA DrugMolecule @relation("InteractionA", fields: [moleculeAId], references: [id], onDelete: Restrict)
  moleculeB DrugMolecule @relation("InteractionB", fields: [moleculeBId], references: [id], onDelete: Restrict)

  @@unique([moleculeAId, moleculeBId])
  @@index([moleculeBId])
  @@map("drug_interactions")
}

/// An allergy to one drug class that warns for another (SR-03), e.g. penicillin → cephalosporin.
model DrugCrossSensitivity {
  allergyClass String  @map("allergy_class")
  drugClass    String  @map("drug_class")
  note         String?

  @@id([allergyClass, drugClass])
  @@map("drug_cross_sensitivities")
}

/// A molecule or a whole class that needs care with a condition (SR-09), e.g. an NSAID
/// with chronic kidney disease. A condition matches an ICD-10 code prefix or a term in its name.
model DrugConditionRule {
  id             String   @id @default(uuid()) @db.Uuid
  moleculeId     String?  @map("molecule_id") @db.Uuid
  drugClass      String?  @map("drug_class")
  conditionCodes String[] @map("condition_codes")
  conditionTerms String[] @map("condition_terms")
  note           String

  molecule DrugMolecule? @relation(fields: [moleculeId], references: [id], onDelete: Restrict)

  @@index([moleculeId])
  @@index([drugClass])
  @@map("drug_condition_rules")
}

/// The loaded reference drug data (one row). Overrides record its version.
model DrugDatabase {
  id       Int      @id @default(1) @db.SmallInt
  version  String
  loadedAt DateTime @default(now()) @map("loaded_at") @db.Timestamptz(3)

  @@map("drug_database")
}

/// A molecule in a medicine, with its strength when known (null for creams and the like).
/// The clinic admin's decision on a medicine doctors typed as free text (PRD §9.2): added
/// to the master or mapped to an existing medicine, or rejected. The queue itself is worked
/// out from the prescriptions; names without a decision are waiting.
model MedicineRequest {
  id              String           @id @default(uuid()) @db.Uuid
  organisationId  String           @map("organisation_id") @db.Uuid
  /// Lower case with single spaces: the same medicine typed differently is one entry.
  nameKey         String           @map("name_key")
  name            String
  decision        MedicineDecision
  /// The medicine it was added as or mapped to (approved only).
  medicineId      String?          @map("medicine_id") @db.Uuid
  reason          String?
  decidedByUserId String           @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime         @default(now()) @map("decided_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([organisationId, nameKey])
  @@index([medicineId])
  @@map("medicine_requests")
}

model MedicineIngredient {
  medicineId String       @map("medicine_id") @db.Uuid
  moleculeId String       @map("molecule_id") @db.Uuid
  strengthMg Decimal?     @map("strength_mg") @db.Decimal(10, 3)
  per        StrengthPer?

  medicine Medicine     @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  molecule DrugMolecule @relation(fields: [moleculeId], references: [id], onDelete: Restrict)

  @@id([medicineId, moleculeId])
  @@index([moleculeId])
  @@map("medicine_ingredients")
}

/// A medicine doctors can prescribe (PRD §6.4). `organisationId` is null for the
/// platform's reference master and set for medicines a clinic adds.
model Medicine {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String?        @map("organisation_id") @db.Uuid
  name           String
  genericName    String         @map("generic_name")
  composition    String
  form           String
  defaultRoute   MedicineRoute  @default(oral) @map("default_route")
  source         MedicineSource
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Moves on every change, so the Clinic app can fetch only what changed (offline cache).
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  ingredients  MedicineIngredient[]
  requests     MedicineRequest[]

  @@index([organisationId])
  @@index([updatedAt, id])
  @@map("medicines")
}

/// A visit's prescription. One draft per visit; amendments will add versions.
/// `revision` guards autosave like consultation notes.
model Prescription {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  doctorUserId   String             @map("doctor_user_id") @db.Uuid
  version        Int                @default(1)
  status         PrescriptionStatus @default(draft)
  language       Language           @default(en)
  revision       Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The version this one corrects, and why (an amendment).
  amendsPrescriptionId String?    @unique @map("amends_prescription_id") @db.Uuid
  amendmentReason      String?    @map("amendment_reason")
  /// The doctor's prefix and a running number, given at the first signing; amendments keep it.
  number               String?
  signedAt             DateTime?  @map("signed_at") @db.Timestamptz(3)
  /// Storage key of the signed PDF (never a public URL) and its SHA-256, hex.
  pdfFileKey           String?    @map("pdf_file_key")
  pdfSha256            String?    @map("pdf_sha256")
  /// Layout version of the PDF, so an old prescription can be explained later.
  templateVersion      String?    @map("template_version")
  paperSize            PaperSize? @map("paper_size")
  /// `test_key` (development and staging) or `cloud_dsc` (ADR 0008).
  signatureMethod      String?    @map("signature_method")
  /// The signature over the PDF's SHA-256, base64, and the certificate that made it.
  signature            String?
  signerCertificate    String?    @map("signer_certificate")
  /// Printed in the QR; the public lookup stores only its hash.
  verificationCode     String?    @unique @map("verification_code")
  supersededAt         DateTime?  @map("superseded_at") @db.Timestamptz(3)
  voidedAt             DateTime?  @map("voided_at") @db.Timestamptz(3)
  voidedByUserId       String?    @map("voided_by_user_id") @db.Uuid
  voidReason           String?    @map("void_reason")
  /// A copy of the signed PDF marked VOID; the signed file itself is kept unchanged.
  voidPdfFileKey       String?    @map("void_pdf_file_key")

  organisation Organisation              @relation(fields: [organisationId], references: [id])
  appointment  Appointment               @relation(fields: [appointmentId], references: [id])
  amends       Prescription?             @relation("Amendment", fields: [amendsPrescriptionId], references: [id], onDelete: Restrict)
  amendedBy    Prescription?             @relation("Amendment")
  items        PrescriptionItem[]
  safetyAlerts SafetyAlert[]
  verification PrescriptionVerification?
  testOrders   TestOrder[]

  @@unique([appointmentId, version])
  @@unique([organisationId, number, version])
  @@index([patientId])
  @@map("prescriptions")
}

/// Public lookup for the QR on a signed prescription (PRD §9.4). Readable by the sign-in
/// role so the verification page works without a session; holds no clinical data.
model PrescriptionVerification {
  codeHash       String   @id @map("code_hash")
  organisationId String   @map("organisation_id") @db.Uuid
  prescriptionId String   @unique @map("prescription_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@map("prescription_verifications")
}

/// A doctor's details for the prescription pad and signing (PRD §9.1), per organisation.
model DoctorProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  organisationId     String             @map("organisation_id") @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  registrationNumber String?            @map("registration_number")
  council            String?
  qualifications     String?
  specialty          String?
  /// Starts the doctor's prescription numbers, e.g. SG-00042. Unique in the organisation.
  rxPrefix           String?            @map("rx_prefix")
  /// The last number given; the next signing takes the one after.
  rxSequence         Int                @default(0) @map("rx_sequence")
  paperSize          PaperSize          @default(a5) @map("paper_size")
  verification       DoctorVerification @default(pending)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  /// The platform operator who checked the registration, and the support ticket.
  verifiedBy         String?            @map("verified_by")
  /// When the profile last went to the platform team for verification: when registration
  /// details were first saved, and again whenever the registration number or council
  /// changes. Null until then (a PIN can be set first).
  submittedAt        DateTime?          @map("submitted_at") @db.Timestamptz(3)
  /// scrypt hash of the PIN that approves each signature on the web.
  signingPinHash     String?            @map("signing_pin_hash")
  pinFailedCount     Int                @default(0) @map("pin_failed_count")
  pinLockedUntil     DateTime?          @map("pin_locked_until") @db.Timestamptz(3)
  /// The public page's address, `/doctor/<publicSlug>` (ADR 0017): lowercase letters, digits
  /// and single hyphens, 3–60 characters, unique across all organisations (CHECK and index
  /// in migration 20261018150000_public_doctor_pages).
  publicSlug         String?            @unique @map("public_slug")
  /// The doctor opted in to the public page. Shown only once the registration is verified.
  listed             Boolean            @default(false)
  /// Shown on the public page, up to 1000 characters.
  about              String?
  /// Languages the doctor consults in, as typed (up to 8, each 1–40 characters).
  languages          String[]           @default([])
  /// When the public fields last changed (sitemap lastmod); updatedAt also moves with PIN attempts.
  publicUpdatedAt    DateTime?          @map("public_updated_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, userId])
  @@unique([organisationId, rxPrefix])
  @@map("doctor_profiles")
}

/// One medicine line. Name and composition are snapshots, so the printed prescription
/// never changes if the master does. `steps` holds dose, frequency and duration, one
/// entry per step of a tapering course. Remarks are generated unless the doctor edited them.
model PrescriptionItem {
  id             String         @id @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  prescriptionId String         @map("prescription_id") @db.Uuid
  medicineId     String?        @map("medicine_id") @db.Uuid
  name           String
  composition    String?
  form           String?
  route          MedicineRoute?
  timing         DoseTiming?
  steps          Json
  quantity       String?
  instructions   String?
  remarks        String
  remarksEdited  Boolean        @default(false) @map("remarks_edited")
  sortOrder      Int            @map("sort_order")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// A doctor's saved set of lines (PRD §6.4 "save as template").
model PrescriptionTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  doctorUserId   String   @map("doctor_user_id") @db.Uuid
  name           String
  items          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, doctorUserId, name])
  @@map("prescription_templates")
}

/// Chargeable services besides the consultation (PRD §5.6): dressing, injection, X-ray
/// review. Never deleted, only deactivated, so old bills keep their meaning.
model PriceListItem {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  pricePaise     Int      @map("price_paise")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  billItems    BillItem[]

  @@unique([organisationId, name])
  @@map("price_list_items")
}

/// One bill per visit (PRD §5.6). Every amount is set by the server; the lines can change
/// until the first payment, then the bill is fixed.
model Bill {
  id              String     @id @default(uuid()) @db.Uuid
  organisationId  String     @map("organisation_id") @db.Uuid
  appointmentId   String     @unique @map("appointment_id") @db.Uuid
  patientId       String     @map("patient_id") @db.Uuid
  doctorUserId    String     @map("doctor_user_id") @db.Uuid
  subtotalPaise   Int        @map("subtotal_paise")
  discountPaise   Int        @default(0) @map("discount_paise")
  discountReason  String?    @map("discount_reason")
  totalPaise      Int        @map("total_paise")
  paidPaise       Int        @default(0) @map("paid_paise")
  /// Set from the amounts with billStatus(); no default, since a ₹0 bill is already paid.
  status          BillStatus
  /// Guards against two people editing the same bill (0 is "no bill yet").
  revision        Int        @default(1)
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  items        BillItem[]
  payments     Payment[]

  @@index([organisationId, createdAt])
  @@index([patientId])
  @@map("bills")
}

model BillItem {
  id              String       @id @default(uuid()) @db.Uuid
  organisationId  String       @map("organisation_id") @db.Uuid
  billId          String       @map("bill_id") @db.Uuid
  kind            BillLineKind
  priceListItemId String?      @map("price_list_item_id") @db.Uuid
  /// The name and price at the time of billing; later price-list changes do not touch it.
  name            String
  unitPaise       Int          @map("unit_paise")
  quantity        Int
  amountPaise     Int          @map("amount_paise")
  sortOrder       Int          @map("sort_order")

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  bill          Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  priceListItem PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@map("bill_items")
}

/// A counter payment and its receipt. The ID comes from the client, so a retried
/// request records the payment once.
model Payment {
  id               String      @id @db.Uuid
  organisationId   String      @map("organisation_id") @db.Uuid
  billId           String      @map("bill_id") @db.Uuid
  mode             PaymentMode
  amountPaise      Int         @map("amount_paise")
  /// UPI transaction or card slip reference, as written on the slip.
  reference        String?
  receiptNumber    String      @map("receipt_number")
  receivedByUserId String      @map("received_by_user_id") @db.Uuid
  receivedAt       DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  bill         Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([organisationId, receiptNumber])
  @@index([organisationId, receivedAt])
  @@index([billId])
  @@map("payments")
}

/// Receipt numbering, one row per organisation, advanced inside the payment's transaction.
model ReceiptSettings {
  organisationId String   @id @map("organisation_id") @db.Uuid
  prefix         String   @default("R")
  nextNumber     Int      @default(1) @map("next_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("receipt_settings")
}

/// An alert the safety engine raised on a prescription, and what the doctor did with it
/// (PRD §6.5). One row per alert key; `resolvedAt` is set while the alert no longer fires.
model SafetyAlert {
  id                  String             @id @default(uuid()) @db.Uuid
  organisationId      String             @map("organisation_id") @db.Uuid
  prescriptionId      String             @map("prescription_id") @db.Uuid
  /// Rule, line and subject (e.g. the other molecule), so a different problem is a new alert.
  key                 String
  ruleId              String             @map("rule_id")
  itemId              String?            @map("item_id") @db.Uuid
  severity            SafetySeverity
  overridable         Boolean
  message             String
  params              Json
  firstShownAt        DateTime           @map("first_shown_at") @db.Timestamptz(3)
  lastShownAt         DateTime           @map("last_shown_at") @db.Timestamptz(3)
  resolvedAt          DateTime?          @map("resolved_at") @db.Timestamptz(3)
  action              SafetyAlertAction?
  reason              String?
  actionByUserId      String?            @map("action_by_user_id") @db.Uuid
  actionAt            DateTime?          @map("action_at") @db.Timestamptz(3)
  drugDatabaseVersion String             @map("drug_database_version")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, key])
  @@map("safety_alerts")
}

/// A test doctors can order (PRD §7.1), per organisation. Every organisation starts with
/// a default set (a database trigger seeds it). Imaging lists the body regions and, for
/// X-rays, the views a doctor picks from; an order snapshots what was picked. Clinic admins
/// add, edit, reorder and deactivate items (API guide §3t); orders already placed never change.
model TestCatalogueItem {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  kind           TestKind
  name           String
  regions        String[] @default([])
  views          String[] @default([])
  active         Boolean  @default(true)
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  orders       TestOrder[]

  // Names are unique per organisation among active items, whatever the case: the partial
  // index `test_catalogue_items_active_name_key` on (organisation_id, lower(name)) WHERE
  // active, written in migration 20261018120000_test_catalogue_admin (Prisma cannot express
  // it). Items are deactivated, never deleted, since orders point at them.
  @@index([organisationId, sortOrder])
  @@map("test_catalogue_items")
}

/// One test a doctor ordered at a visit (PRD §7.1). Written with the visit's prescription
/// draft and locked when a version is signed: `orderedAt` and `prescriptionId` (the version
/// that first printed it) are set then, and from then on only the status moves:
/// ordered → result_uploaded → reviewed. The ID is chosen by the client, like a line's.
model TestOrder {
  id               String          @id @db.Uuid
  organisationId   String          @map("organisation_id") @db.Uuid
  appointmentId    String          @map("appointment_id") @db.Uuid
  patientId        String          @map("patient_id") @db.Uuid
  doctorUserId     String          @map("doctor_user_id") @db.Uuid
  catalogueItemId  String?         @map("catalogue_item_id") @db.Uuid
  kind             TestKind
  /// Snapshot of the catalogue name, or free text.
  name             String
  region           String?
  side             TestSide        @default(na)
  views            String[]        @default([])
  notes            String?
  sortOrder        Int             @map("sort_order")
  status           TestOrderStatus @default(ordered)
  prescriptionId   String?         @map("prescription_id") @db.Uuid
  orderedAt        DateTime?       @map("ordered_at") @db.Timestamptz(3)
  resultUploadedAt DateTime?       @map("result_uploaded_at") @db.Timestamptz(3)
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId String?         @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation  Organisation       @relation(fields: [organisationId], references: [id])
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  catalogueItem TestCatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: Restrict)
  prescription  Prescription?      @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  results       TestResult[]

  @@index([appointmentId])
  @@index([patientId])
  @@index([organisationId, doctorUserId, status])
  @@map("test_orders")
}

/// An uploaded result for an order (PRD §7.1, §4.4): the file is stored by key (never a
/// public URL) with its type, size and SHA-256. Append-only.
model TestResult {
  id               String   @id @default(uuid()) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  testOrderId      String   @map("test_order_id") @db.Uuid
  fileKey          String   @map("file_key")
  mediaType        String   @map("media_type")
  sizeBytes        Int      @map("size_bytes")
  sha256           String
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  /// patient (the Patient app or portal), front_desk or doctor; a database check refuses
  /// any other role.
  uploadedByRole   Role     @map("uploaded_by_role")
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  testOrder    TestOrder    @relation(fields: [testOrderId], references: [id], onDelete: Restrict)

  @@index([testOrderId])
  @@map("test_results")
}

/// A referral made at a visit (PRD §7.2): to a doctor of the same organisation (internal)
/// or to someone outside it (external), with a reason, urgency and notes. Internal
/// referrals open the patient's chart to the receiving doctor under "own patients only"
/// while not closed. Never deleted; after it is made only the status and what goes with
/// it change (database trigger).
model Referral {
  id                    String          @id @default(uuid()) @db.Uuid
  organisationId        String          @map("organisation_id") @db.Uuid
  /// The visit it was made at; its patient and doctor are the referral's (trigger).
  appointmentId         String          @map("appointment_id") @db.Uuid
  patientId             String          @map("patient_id") @db.Uuid
  referringDoctorUserId String          @map("referring_doctor_user_id") @db.Uuid
  kind                  ReferralKind
  /// Internal only: a doctor of the organisation, not the referring one.
  receivingDoctorUserId String?         @map("receiving_doctor_user_id") @db.Uuid
  /// External only: who the patient is sent to (name required, the rest optional).
  externalName          String?         @map("external_name")
  externalSpecialty     String?         @map("external_specialty")
  externalHospital      String?         @map("external_hospital")
  externalPhone         String?         @map("external_phone")
  reason                String
  urgency               ReferralUrgency
  notes                 String?
  status                ReferralStatus  @default(sent)
  sentAt                DateTime        @map("sent_at") @db.Timestamptz(3)
  seenAt                DateTime?       @map("seen_at") @db.Timestamptz(3)
  closedAt              DateTime?       @map("closed_at") @db.Timestamptz(3)
  /// The referring or the receiving doctor.
  closedByUserId        String?         @map("closed_by_user_id") @db.Uuid
  closeNote             String?         @map("close_note")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  appointment  Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  letter       ReferralLetter?

  @@index([appointmentId])
  @@index([patientId])
  @@index([organisationId, receivingDoctorUserId, status])
  @@index([organisationId, referringDoctorUserId, status])
  @@map("referrals")
}

/// The signed referral letter PDF (PRD §7.2): at most one per referral, signed by its
/// referring doctor with the signing PIN while the referral was not closed. Insert-only:
/// it never changes and is never deleted (triggers), and closing the referral leaves it
/// valid. The PDF is in the file store by key, with its SHA-256 and signature (ADR 0008).
model ReferralLetter {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  referralId        String    @unique @map("referral_id") @db.Uuid
  /// The referral's referring doctor (trigger).
  signedByUserId    String    @map("signed_by_user_id") @db.Uuid
  language          Language
  paperSize         PaperSize @map("paper_size")
  /// The layout it was rendered with (`referral-1`).
  templateVersion   String    @map("template_version")
  pdfFileKey        String    @map("pdf_file_key")
  pdfSha256         String    @map("pdf_sha256")
  /// `test_key` (development and staging) or `cloud_dsc`.
  signatureMethod   String    @map("signature_method")
  signature         String
  signerCertificate String    @map("signer_certificate")
  /// The code in the QR (`/verify/referral/<code>`); its hash is the public lookup.
  verificationCode  String    @unique @map("verification_code")
  signedAt          DateTime  @map("signed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation                @relation(fields: [organisationId], references: [id])
  referral     Referral                    @relation(fields: [referralId], references: [id], onDelete: Restrict)
  verification ReferralLetterVerification?

  @@map("referral_letters")
}

/// The QR lookup for referral letters, like `prescription_verifications`: a hash of the
/// code and the IDs, nothing clinical; read without a session by the sign-in role.
model ReferralLetterVerification {
  codeHash         String   @id @map("code_hash")
  organisationId   String   @map("organisation_id") @db.Uuid
  referralLetterId String   @unique @map("referral_letter_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  referralLetter ReferralLetter @relation(fields: [referralLetterId], references: [id])

  @@map("referral_letter_verifications")
}

/// One stored document file (PRD §7.3): a PDF, JPEG, PNG or WebP uploaded by a doctor or a
/// clinic admin, in the file store by key (never a public URL) with its type, size and
/// SHA-256. Never changes or is deleted (trigger); `attachedAt` is set once, when a fresh
/// upload is first used for a library sheet or a share. A file is a version: a library
/// sheet given a new file points at a new row, and shares keep the row they were made with.
model DocumentFile {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  /// `organisations/<org>/documents/<random>.<ext>` (database check).
  fileKey          String    @unique @map("file_key")
  mediaType        String    @map("media_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  /// doctor or clinic_admin (database check).
  uploadedByRole   Role      @map("uploaded_by_role")
  uploadedAt       DateTime  @map("uploaded_at") @db.Timestamptz(3)
  attachedAt       DateTime? @map("attached_at") @db.Timestamptz(3)

  organisation     Organisation      @relation(fields: [organisationId], references: [id])
  libraryDocuments LibraryDocument[]
  patientDocuments PatientDocument[]

  @@map("document_files")
}

/// A reusable sheet in the clinic library (PRD §7.3): exercise sheets, diet charts,
/// information leaflets. Renamed, given a new file, archived and restored by clinic admins
/// and doctors; never deleted (trigger), since shares point at it.
model LibraryDocument {
  id               String            @id @default(uuid()) @db.Uuid
  organisationId   String            @map("organisation_id") @db.Uuid
  title            String
  category         DocumentCategory?
  language         DocumentLanguage
  /// The current version; shares keep the version they were made with.
  fileId           String            @map("file_id") @db.Uuid
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  archivedByUserId String?           @map("archived_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  file         DocumentFile      @relation(fields: [fileId], references: [id], onDelete: Restrict)
  shares       PatientDocument[]

  @@index([organisationId, archivedAt])
  @@index([fileId])
  @@map("library_documents")
}

/// A document shared with a patient by a doctor (PRD §7.3; the PRD's Attachment): a library
/// sheet or a one-off upload (a report), with an optional note. Keeps its own title,
/// category and language and the exact file it was shared with. Part of the clinical
/// record. Withdrawing hides it from the patient; only the first opening by the patient and
/// the withdrawal are ever written after it is made, and it is never deleted (trigger).
model PatientDocument {
  id                String                @id @default(uuid()) @db.Uuid
  organisationId    String                @map("organisation_id") @db.Uuid
  patientId         String                @map("patient_id") @db.Uuid
  /// The visit it was shared at, when shared from the consultation screen.
  appointmentId     String?               @map("appointment_id") @db.Uuid
  source            PatientDocumentSource
  /// Library shares only.
  libraryDocumentId String?               @map("library_document_id") @db.Uuid
  fileId            String                @map("file_id") @db.Uuid
  title             String
  category          DocumentCategory?
  language          DocumentLanguage?
  /// To the patient; shown to them with the document.
  note              String?
  sharedByUserId    String                @map("shared_by_user_id") @db.Uuid
  sharedAt          DateTime              @map("shared_at") @db.Timestamptz(3)
  /// The first time the patient (or a family member on the account) opened it.
  openedAt          DateTime?             @map("opened_at") @db.Timestamptz(3)
  withdrawnAt       DateTime?             @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnByUserId String?               @map("withdrawn_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation    Organisation     @relation(fields: [organisationId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  libraryDocument LibraryDocument? @relation(fields: [libraryDocumentId], references: [id], onDelete: Restrict)
  file            DocumentFile     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([appointmentId])
  @@index([libraryDocumentId])
  @@index([fileId])
  @@map("patient_documents")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  requestId      String?  @map("request_id")
  ip             String?
  userAgent      String?  @map("user_agent")
  metadata       Json?
  at             DateTime @default(now()) @db.Timestamptz(3)

  @@index([organisationId, at])
  @@map("audit_logs")
}

/// A patient account's acceptance of the privacy notice, terms or health-data consent
/// (PRD §4.1, C9), one row per acceptance. Withdrawing keeps the row and sets withdrawnAt.
model AccountConsent {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// privacy_notice, terms or health_data
  kind           String
  version        String
  acceptedAt     DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(3)
  withdrawnAt    DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organisationId, userId, kind])
  @@map("account_consents")
}

/// A retryable write's first result, replayed for 24 hours when the same person sends the
/// same Idempotency-Key again (API guide §2). A row without a status is still running.
model IdempotencyKey {
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  method         String
  path           String
  requestHash    String   @map("request_hash")
  /// Which attempt holds the key; a write commits only while its attempt still holds it.
  claim          String   @db.Uuid
  /// Set in the write's own transaction, so a retry knows whether the write happened.
  writeCommitted Boolean  @default(false) @map("write_committed")
  statusCode     Int?     @map("status_code")
  response       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@id([organisationId, userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Platform staff (PRD §3.2: organisations, doctor verification, usage and system health
/// only). Not a clinic user: no memberships, no clinical access. Created and disabled only
/// by the support command (docs/runbooks/platform-operators.md), never over HTTP. Reachable
/// only as the dhc_platform role (ADR 0016).
model PlatformOperator {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  displayName      String     @map("display_name")
  status           UserStatus @default(active)
  passwordHash     String     @map("password_hash")
  /// AES-256-GCM encrypted TOTP secret, confirmed when the operator was created.
  mfaSecret        String     @map("mfa_secret")
  /// Last accepted TOTP time step; a code is never accepted twice.
  mfaLastUsedStep  Int?       @map("mfa_last_used_step")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions PlatformSession[]

  @@map("platform_operators")
}

/// A platform console sign-in. Like a staff session, but for an operator and never tied
/// to an organisation. Tokens are stored as SHA-256 hashes only.
model PlatformSession {
  id                       String    @id @default(uuid()) @db.Uuid
  operatorId               String    @map("operator_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  userAgent                String?   @map("user_agent")
  ip                       String?
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  operator PlatformOperator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@map("platform_sessions")
}
